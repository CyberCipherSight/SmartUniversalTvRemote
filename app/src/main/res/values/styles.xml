<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PanasonicRemote" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="RemoteButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_remote_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="RemoteButton.Power" parent="RemoteButton"><item name="android:background">@drawable/bg_power_button</item></style>
    <style name="RemoteButton.Accent" parent="RemoteButton"><item name="android:background">@drawable/bg_accent_button</item></style>
</resources>
