<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/simpleModeScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp" android:paddingBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:id="@+id/simpleProfileText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV Remote" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />

                    <TextView android:id="@+id/simpleStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:maxLines="1" android:text="Loading remote…" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>

                <Button android:id="@+id/advancedModeButton" android:layout_width="54dp" android:layout_height="44dp" android:background="@drawable/bg_remote_button" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="⚙" android:textColor="@color/text_primary" android:textSize="20sp" />
            </LinearLayout>

            <Button android:id="@+id/simpleSetupButton" style="@style/RemoteButton.Accent" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:layout_weight="0" android:text="SET UP TV" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_remote_shell" android:orientation="vertical" android:padding="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button style="@style/RemoteButton.Power" android:tag="POWER" android:text="POWER" />
                    <Button style="@style/RemoteButton" android:tag="INPUT" android:text="INPUT" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button style="@style/RemoteButton" android:tag="HOME" android:text="HOME" />
                    <Button style="@style/RemoteButton" android:tag="MENU" android:text="MENU" />
                    <Button style="@style/RemoteButton" android:tag="BACK" android:text="BACK" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <Button style="@style/RemoteButton" android:layout_weight="1.15" android:tag="UP" android:text="▲" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button style="@style/RemoteButton" android:tag="LEFT" android:text="◀" />
                    <Button style="@style/RemoteButton.Accent" android:tag="OK" android:text="OK" />
                    <Button style="@style/RemoteButton" android:tag="RIGHT" android:text="▶" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <Button style="@style/RemoteButton" android:layout_weight="1.15" android:tag="DOWN" android:text="▼" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button style="@style/RemoteButton" android:tag="VOL_UP" android:text="VOL +" />
                    <Button style="@style/RemoteButton" android:tag="MUTE" android:text="MUTE" />
                    <Button style="@style/RemoteButton" android:tag="CH_UP" android:text="CH +" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button style="@style/RemoteButton" android:tag="VOL_DOWN" android:text="VOL −" />
                    <Button style="@style/RemoteButton" android:tag="TV" android:text="TV" />
                    <Button style="@style/RemoteButton" android:tag="CH_DOWN" android:text="CH −" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    
    