<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton.Power" android:tag="POWER" android:text="POWER" /><Button style="@style/RemoteButton" android:tag="INPUT" android:text="INPUT" /><Button style="@style/RemoteButton" android:tag="HOME" android:text="HOME" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="MENU" android:text="MENU" /><Button style="@style/RemoteButton" android:tag="GUIDE" android:text="GUIDE" /><Button style="@style/RemoteButton" android:tag="INFO" android:text="INFO" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="SETTINGS" android:text="SETTINGS" /><Button style="@style/RemoteButton" android:tag="ASPECT" android:text="ASPECT" /><Button style="@style/RemoteButton" android:tag="OPTION" android:text="OPTION" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal"><View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" /><Button style="@style/RemoteButton" android:layout_weight="1.15" android:tag="UP" android:text="▲" /><View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="LEFT" android:text="◀" /><Button style="@style/RemoteButton.Accent" android:tag="OK" android:text="OK" /><Button style="@style/RemoteButton" android:tag="RIGHT" android:text="▶" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="BACK" android:text="BACK" /><Button style="@style/RemoteButton" android:tag="DOWN" android:text="▼" /><Button style="@style/RemoteButton" android:tag="EXIT" android:text="EXIT" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="VOL_UP" android:text="VOL +" /><Button style="@style/RemoteButton" android:tag="MUTE" android:text="MUTE" /><Button style="@style/RemoteButton" android:tag="CH_UP" android:text="CH +" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="VOL_DOWN" android:text="VOL −" /><Button style="@style/RemoteButton" android:tag="TV" android:text="TV" /><Button style="@style/RemoteButton" android:tag="CH_DOWN" android:text="CH −" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="1" android:text="1" /><Button style="@style/RemoteButton" android:tag="2" android:text="2" /><Button style="@style/RemoteButton" android:tag="3" android:text="3" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="4" android:text="4" /><Button style="@style/RemoteButton" android:tag="5" android:text="5" /><Button style="@style/RemoteButton" android:tag="6" android:text="6" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="7" android:text="7" /><Button style="@style/RemoteButton" android:tag="8" android:text="8" /><Button style="@style/RemoteButton" android:tag="9" android:text="9" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="HDMI_1" android:text="HDMI 1" /><Button style="@style/RemoteButton" android:tag="0" android:text="0" /><Button style="@style/RemoteButton" android:tag="HDMI_2" android:text="HDMI 2" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="HDMI_3" android:text="HDMI 3" /><Button style="@style/RemoteButton" android:tag="PLAY" android:text="PLAY" /><Button style="@style/RemoteButton" android:tag="PAUSE" android:text="PAUSE" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:background="@drawable/bg_red_key" android:tag="RED" android:text="R" /><Button style="@style/RemoteButton" android:background="@drawable/bg_green_key" android:tag="GREEN" android:text="G" /><Button style="@style/RemoteButton" android:background="@drawable/bg_yellow_key" android:tag="YELLOW" android:text="Y" /><Button style="@style/RemoteButton" android:background="@drawable/bg_blue_key" android:tag="BLUE" android:text="B" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button style="@style/RemoteButton" android:tag="NETFLIX" android:text="NETFLIX" /><Button style="@style/RemoteButton" android:tag="PRIME" android:text="PRIME" /><Button style="@style/RemoteButton" android:tag="YOUTUBE" android:text="YOUTUBE" /></LinearLayout>
</LinearLayout>
